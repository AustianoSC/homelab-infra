# Generated by OpenTofu from local.nodes in infra/nodes.tf. Do not edit by hand.
all:
  vars:
    ansible_user: ${admin_user}
  children:
    k3s_server:
      hosts:
%{ for name, node in nodes ~}
%{ if node.role == "server" ~}
        ${name}:
          ansible_host: ${node.ip}
%{ endif ~}
%{ endfor ~}
    k3s_agent:
      hosts:
%{ for name, node in nodes ~}
%{ if node.role == "agent" ~}
        ${name}:
          ansible_host: ${node.ip}
%{ endif ~}
%{ endfor ~}
    k3s:
      children:
        k3s_server:
        k3s_agent:
