# Secrets: .env is generated from .env.tpl via `op inject` and must never be committed
.env
.env.*
!.env.tpl

# OpenTofu. State stays out of git even when encrypted; .terraform.lock.hcl is
# committed so provider versions and checksums are pinned.
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
.terraform/
crash.log

# Ansible
*.retry
.ansible/

# Cluster credentials
kubeconfig
*.kubeconfig

# Game server runtime data (bind mount target)
apps/palworld/palworld/

# Palworld save data must never land in git
*.sav
*.zip

# OS / editor noise
.DS_Store
*.swp
.tofu-lint/
.venv-validate/
